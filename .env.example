# Database (Neon serverless Postgres)
DATABASE_URL="postgresql://user:pass@ep-xxxx.neon.tech/studenthousing?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxxx.neon.tech/studenthousing?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-32-byte-random-string"
JWT_EXPIRES_IN="7d"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Student Housing <noreply@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Maps Platform (Maps JavaScript API, Places API, Geocoding API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyHere"

# OTP
OTP_TTL_MINUTES="10"

# University email domain allow-list (comma separated)
ALLOWED_UNIVERSITY_DOMAINS="wits.ac.za,uct.ac.za,up.ac.za"
